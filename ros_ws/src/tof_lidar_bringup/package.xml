<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypeneds="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>tof_lidar_bringup</name>
  <version>1.0.0</version>
  <description>ROS &amp; ROS 2 package for Arducam B0410 ToF Camera and YDLIDAR X2 Sensor Fusion</description>
  
  <maintainer email="sudharsan@example.com">Sudharsan</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>cv_bridge</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
